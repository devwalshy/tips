# TipJar Environment Configuration

# ===================================================
# OCR Engine Configuration
# ===================================================

# Which OCR engine to use: auto, mindee, or tesseract
# - auto: Try Mindee first, fallback to Tesseract (RECOMMENDED)
# - mindee: Only use Mindee OCR (requires credentials below)
# - tesseract: Only use Tesseract (free, offline, no setup needed)
OCR_ENGINE=auto

# ===================================================
# Mindee OCR (Recommended)
# ===================================================
# Sign up for Mindee (https://www.mindee.com/) and generate an API key
# Required variables:
# - MINDEE_API_KEY: Mindee API key with access to the Universal OCR product
# Optional overrides:
# - MINDEE_ENDPOINT (defaults to https://api.mindee.net/v1/products/mindee/universal-ocr/v1)
# - MINDEE_MAX_RETRIES (defaults to 3)
# - MINDEE_TIMEOUT_MS (defaults to 30000)
# - MINDEE_RETRY_DELAY_MS (defaults to 1000)

MINDEE_API_KEY=
# MINDEE_ENDPOINT=https://api.mindee.net/v1/products/mindee/universal-ocr/v1
# MINDEE_MAX_RETRIES=3
# MINDEE_TIMEOUT_MS=30000
# MINDEE_RETRY_DELAY_MS=1000

# ===================================================
# Database (Optional - uses in-memory by default)
# ===================================================
# DATABASE_URL=postgresql://username:password@hostname:5432/database

# ===================================================
# Session Configuration
# ===================================================
# Generate a random string for production
# SESSION_SECRET=your-secret-key-here

# ===================================================
# Server Configuration
# ===================================================
# PORT=5000

# ===================================================
# DEPRECATED: Gemini API (Removed for Privacy)
# ===================================================
# GEMINI_API_KEY is NO LONGER USED
# 
# Gemini AI was replaced with privacy-compliant OCR:
# - Mindee OCR for production-grade accuracy
# - Tesseract OCR (free fallback)
#
# Both options do NOT train on your data.


